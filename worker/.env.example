AGENT37_API_KEY=sk_live_...
AGENT37_INSTANCE_ID=...
GITHUB_REPO=https://github.com/prophen/ship-it

# Supabase (sponsor)
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# OpenAI
OPENAI_API_KEY=...
OPENAI_MODEL=gpt-5-mini

# Exa (her own key; verification step)
EXA_API_KEY=...

# Sanity CBS knowledge base (dedupe only: what is already covered)
SANITY_PROJECT_ID=bq2hoxdt
SANITY_DATASET=production
SANITY_TYPE=story

# Buffer publishing (her Hermes token, regenerated 2026-10-04).
# GraphQL API: run `node channels.mjs` to get the org id, then
# `node channels.mjs <org-id>` to list channels, then map each platform:
BUFFER_ACCESS_TOKEN=...
BUFFER_CHANNELS={"x":"<channel-id>","instagram":"<channel-id>","facebook":"<channel-id>","linkedin":"<channel-id>"}
# shareNow posts immediately (demo-friendly). If Buffer rejects the mode enum,
# its error names the valid values; use addToQueue to queue instead.
BUFFER_SHARE_MODE=shareNow
